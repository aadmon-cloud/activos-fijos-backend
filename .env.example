GCP_PROJECT_ID=
GOOGLE_CLOUD_RUN_AUDIENCE=

# Ingreso con Google (unico metodo). GOOGLE_CLIENT_ID es el ID de cliente OAuth tipo "Aplicacion web".
# LOGIN_PASSWORD_HABILITADO reabre el ingreso con contrasena: solo para pruebas automatizadas en local.
GOOGLE_CLIENT_ID=
LOGIN_PASSWORD_HABILITADO=false
ENTORNO=local
SYSTEM_NAME=fastapi-cloud-run-template

MONGO_URL=mongodb://localhost:27017
MONGO_DB=fastapi_cloud_run_template
MONGO_CERT_SECRET_NAME=

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=180

# Sesion por cookie HttpOnly. COOKIE_SECURE=false solo para desarrollo local sobre http.
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# Origenes permitidos (lista JSON). Nunca "*": se usan credenciales.
CORS_ORIGINS=["http://localhost:3000"]

# Correo real (auditorias). En local, SMTP_PASSWORD se lee tal cual de este archivo;
# en el resto de entornos se ignora y se usa SMTP_PASSWORD_SECRET_NAME via GCP Secret Manager.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_SECRET_NAME=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sistema de Activos Fijos
SMTP_USE_TLS=true

# Enlaces de los correos y recordatorios automaticos.
# APP_URL: direccion publica del frontend (sin barra final), p. ej. https://activos.ejemplo.org
# SCHEDULER_SERVICE_ACCOUNT_EMAIL: cuenta de servicio de Cloud Scheduler que puede disparar los recordatorios.
APP_URL=
SCHEDULER_SERVICE_ACCOUNT_EMAIL=
